local module = {}

local ParserModule = script.Parent:WaitForChild("Parser", math.huge)
local ParserLib = require(ParserModule)

local function skipValue(src: string, p: number): number
	local n = #src
	local nest = 0
	local j = p

	while j <= n do
		local c = src:sub(j, j)

		if c == '"' or c == "'" then
			j += 1
			while j <= n do
				local d = src:sub(j, j)
				if d == "\\" then
					j += 2
				elseif d == c then
					break
				else
					j += 1
				end
			end
			j += 1

		elseif c == "{" or c == "(" or c == "[" then
			nest += 1
			j += 1

		elseif c == "}" or c == ")" or c == "]" then
			if nest == 0 then
				return j
			end
			nest -= 1
			j += 1

		elseif c == "," and nest == 0 then
			return j

		else
			j += 1
		end
	end

	return j
end

function module.format(src: string): string
	local out = {}
	local counters = {}
	local depth = 0
	local i, n = 1, #src

	while i <= n do
		local c = src:sub(i, i)

		if c == "{" then
			depth += 1
			counters[depth] = 0
			table.insert(out, c)
			i += 1

		elseif c == "}" then
			counters[depth] = nil
			depth -= 1
			table.insert(out, c)
			i += 1

		elseif c == '"' or c == "'" then
			local j = i + 1
			while j <= n do
				local d = src:sub(j, j)
				if d == "\\" then
					j += 2
				elseif d == c then
					break
				else
					j += 1
				end
			end
			table.insert(out, src:sub(i, j))
			i = j + 1

		elseif c == "[" then
			local ws, quote, name, rest = src:match('^%[(%s*)(["\'])(.-)%2(%s*%]%s*=)', i)

			if name and depth > 0 then
				local length = 1 + #ws + 1 + #name + 1 + #rest

				if name:find("~!", 1, true) then
					-- excluded: copy the key AND its whole value untouched, then move on
					local valueEnd = skipValue(src, i + length)
					table.insert(out, src:sub(i, valueEnd - 1))
					i = valueEnd
				else
					counters[depth] += 1
					table.insert(out, string.format(
						'[%s%s~%d~%s%s%s',
						ws, quote, counters[depth], name, quote, rest
						))
					i += length
				end
			else
				table.insert(out, c)
				i += 1
			end

		else
			table.insert(out, c)
			i += 1
		end
	end

	return ParserLib.parseTable(table.concat(out))
end

return module
