local originals = table

local Resolve = loadstring(game:HttpGet('https://raw.githubusercontent.com/ssq-wow/S.N-Null/refs/heads/main/UI.Library/ResolveUrl'))()

local Registry = loadstring(Resolve.FetchURL("env.Registry"))()
local before, after = {}, {}

local realPairs, realIpairs, realNext = pairs, ipairs, next
local realUnpack, realRawget, realRawlen = unpack, rawget, rawlen

local READ = {
	concat = true, find = true, unpack = true, getn = true, maxn = true,
	clone = true, isfrozen = true, foreach = true, foreachi = true,
}
local WRITE = { insert = true, remove = true, sort = true, clear = true, move = true }
local BLOCKED = { freeze = true }

local Module = {}

function Module.listen(callback, phase)
	originals.insert(phase == "after" and after or before, callback)
end

local function commit(proxy, real, copy)
	local changes = {}
	for k, v in copy do
		if real[k] ~= v then changes[k] = v end
	end
	local removed = {}
	for k in real do
		if copy[k] == nil then originals.insert(removed, k) end
	end

	for k, v in changes do proxy[k] = v end
	for _, k in removed do proxy[k] = nil end
end

local function makeWrapper(name, original, tag)
	return function(...)
		for _, callback in ipairs(before) do
			if callback(tag, name, ...) == false then
				return
			end
		end

		local args = originals.pack(...)
		local copies = {}

		for i = 1, args.n do
			local v = args[i]
			local real = type(v) == "table" and Registry.get(v)
			if real then
				if READ[name] then
					args[i] = real
				elseif WRITE[name] then
					local entry = copies[v]
					if not entry then
						entry = { real = real, copy = originals.clone(real) }
						copies[v] = entry
					end
					args[i] = entry.copy
				elseif BLOCKED[name] then
					error("table." .. name .. " is not allowed on a proxy")
				end
			end
		end

		local results = originals.pack(original(originals.unpack(args, 1, args.n)))

		for proxy, entry in copies do
			commit(proxy, entry.real, entry.copy)
		end

		for _, callback in ipairs(after) do
			callback(tag, name, ...)
		end

		return originals.unpack(results, 1, results.n)
	end
end

function Module.installTo(env, tag)
	local wrappers = {}
	env.table = setmetatable({}, {
		__index = function(_, key)
			local original = originals[key]
			if type(original) ~= "function" then
				return original
			end
			if not wrappers[key] then
				wrappers[key] = makeWrapper(key, original, tag)
			end
			return wrappers[key]
		end,
		__newindex = function()
			error("table proxy is read-only")
		end,
	})
	
	env.pairs = function(t, ...)
		return realPairs(Registry.get(t) or t, ...)
	end

	env.ipairs = function(t, ...)
		return realIpairs(Registry.get(t) or t, ...)
	end

	env.next = function(t, k)
		return realNext(Registry.get(t) or t, k)
	end
	
	env.unpack = function(t, ...)
		return realUnpack(Registry.get(t) or t, ...)
	end
	env.rawget = function(t, k)
		return realRawget(Registry.get(t) or t, k)
	end
	env.rawlen = function(t)
		return realRawlen(Registry.get(t) or t)
	end
end

return Module
