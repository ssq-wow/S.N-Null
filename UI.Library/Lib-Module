	local function sampleGradient(percentage, keypoints)
		percentage = math.clamp(percentage, 0, 1)

		for i = 1, #keypoints - 1 do
			local left, right = keypoints[i], keypoints[i + 1]

			if left.Time <= percentage and right.Time >= percentage then
				local span = right.Time - left.Time
				local alpha = span > 0 and (percentage - left.Time) / span or 0

				return left.Value:Lerp(right.Value, alpha)
			end
		end

		if percentage <= keypoints[1].Time then
			return keypoints[1].Value
		end
		return keypoints[#keypoints].Value
	end

	local function applyLightnessFloat(r, g, b, lightness)
		local t = math.clamp(lightness, 0, 1)

		if t < 0.5 then
			local k = ((0.5 - t) * 2) ^ EASE
			return r + (255 - r) * k, g + (255 - g) * k, b + (255 - b) * k
		end

		local k = ((t - 0.5) * 2) ^ EASE
		return r * (1 - k), g * (1 - k), b * (1 - k)
	end

	local function round(n)
		return math.floor(n + 0.5)
	end

	local function applyLightness(r, g, b, lightness)
		local fr, fg, fb = applyLightnessFloat(r, g, b, lightness)
		return round(fr), round(fg), round(fb)
	end

	local function getColourRGB(colourPercent)
		local colour = sampleGradient(colourPercent, colourKeypoints)
		return math.floor(colour.R * 255), math.floor(colour.G * 255), math.floor(colour.B * 255)
	end


	local function ditherChannel(value)
		return math.min(255, math.floor(value + math.random()))
	end

	local function buildGrid(parent, name, columns, rows)
		local holder = Instance.new("Frame")
		holder.Name = name
		holder.Size = UDim2.fromScale(1, 1)
		holder.BackgroundTransparency = 1
		holder.BorderSizePixel = 0
		holder.ZIndex = 1
		holder.Parent = parent

		local cells = {}

		for c = 1, columns do
			cells[c] = {}

			for r = 1, rows do
				local cell = Instance.new("Frame")
				cell.BorderSizePixel = 0
				cell.Position = UDim2.fromScale((c - 1) / columns, (r - 1) / rows)
				cell.Size = UDim2.new(1 / columns, 1, 1 / rows, 1)
				cell.ZIndex = 1
				cell.Parent = holder

				cells[c][r] = cell
			end
		end

		return cells
	end

	local function paintColumn(column, r, g, b)
		for _, cell in column do
			cell.BackgroundColor3 = Color3.fromRGB(ditherChannel(r), ditherChannel(g), ditherChannel(b))
		end
	end

