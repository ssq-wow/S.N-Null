local function NewTab(TabName, TabOrder, MainUI)
	local Instances = {
		Tab = Instance.new("ScrollingFrame"),
		UIListLayout = Instance.new("UIListLayout"),
		TabButton = Instance.new("TextButton"),
	}

	for _, v in MainUI.ActiveTabs:GetChildren() do
		if v:IsA("ScrollingFrame") then
			Instances.Tab.Visible = false
		end
	end

	Instances.Tab.Name = TabName
	Instances.Tab.Active = true
	Instances.Tab.AnchorPoint = Vector2.new(0.5, 0.5)
	Instances.Tab.Size = UDim2.new(0.94, 0, 1, 0)
	Instances.Tab.ClipsDescendants = false
	Instances.Tab.BorderColor3 = Color3.new(0, 0, 0)
	Instances.Tab.BackgroundTransparency = 1
	Instances.Tab.Position = UDim2.new(0.5, 0, 0.5, 0)
	Instances.Tab.BorderSizePixel = 0
	Instances.Tab.BackgroundColor3 = Color3.new(1, 1, 1)
	Instances.Tab.AutomaticCanvasSize = Enum.AutomaticSize.Y
	Instances.Tab.CanvasSize = UDim2.new(0, 0, 0, 0)
	Instances.Tab.ScrollBarThickness = 3
	Instances.Tab.Parent = MainUI.ActiveTabs

	Instances.UIListLayout.Name = "UIListLayout"
	Instances.UIListLayout.SortOrder = Enum.SortOrder.LayoutOrder
	Instances.UIListLayout.Padding = UDim.new(0.0199999996, 0)
	Instances.UIListLayout.Parent = Instances.Tab

	Instances.TabButton.Name = TabName
	Instances.TabButton.AutoButtonColor = true
	Instances.TabButton.LayoutOrder = TabOrder*2
	Instances.TabButton.AnchorPoint = Vector2.new(0.5, 0.5)
	Instances.TabButton.AutomaticSize = Enum.AutomaticSize.X
	Instances.TabButton.Size = UDim2.new(0.100000001, 0, 0.699999988, 0)
	Instances.TabButton.BorderColor3 = Color3.new(0, 0, 0)
	Instances.TabButton.Position = UDim2.new(0.5, 0, 0.5, 0)
	Instances.TabButton.BorderSizePixel = 0
	Instances.TabButton.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
	Instances.TabButton.TextColor3 = Color3.new(0, 0, 0)
	Instances.TabButton.Text = " "..TabName.." "
	Instances.TabButton.FontFace = Font.new("rbxasset://fonts/families/SourceSansPro.json", Enum.FontWeight.Regular, Enum.FontStyle.Normal)
	Instances.TabButton.Parent = MainUI.TabsList

	TB_PaddingNew(MainUI.TabsList, (TabOrder*2)+1)

	local Padding = Instance.new("Frame")

	Padding.Name = "Padding"
	Padding.Parent = Instances.Tab
	Padding.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	Padding.BackgroundTransparency = 1.000
	Padding.BorderColor3 = Color3.fromRGB(0, 0, 0)
	Padding.BorderSizePixel = 0
	Padding.LayoutOrder = -100
	Padding.Size = UDim2.new(1, 0, 0.00499999989, 0)

	local StrokeSelect = Instance.new("UIStroke")
	StrokeSelect.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	StrokeSelect.Color = Color3.fromRGB(255, 255, 255)
	StrokeSelect.Enabled = false
	StrokeSelect.Parent = Instances.TabButton

	local function OpenTab()
		for _, v in MainUI.ActiveTabs:GetChildren() do
			if v:IsA("ScrollingFrame") then
				v.Visible = false
			end
		end

		Instances.Tab.Visible = true

		for _, v:TextButton in MainUI.TabsList:GetChildren() do
			if v:IsA("TextButton") and v:FindFirstChildOfClass("UIStroke") then
				v:FindFirstChildOfClass("UIStroke").Enabled = false
				v.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
			end
		end

		StrokeSelect.Enabled = true
	end

	Instances.TabButton.MouseButton1Click:Connect(OpenTab)

	if Instances.Tab.Visible then
		OpenTab()
	end

	return Instances.TabButton, Instances.Tab
end

local function bind(key, callback)
	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed then return end
		if input.KeyCode == key or input.UserInputType == key then
			callback()
		end
	end)
end

local function ScaleFont(label: TextLabel, padding: number?)
	padding = padding or 0
	local targetHeight = label.AbsoluteSize.Y - (padding * 2)

	local low, high = 1, 100
	local best = low

	while low <= high do
		local mid = math.floor((low + high) / 2)

		local bounds = TextService:GetTextSize(
			label.Text ~= "" and label.Text or "Ag",
			mid,
			label.Font,
			Vector2.new(10000, 10000)
		)

		if bounds.Y <= targetHeight then
			best = mid
			low = mid + 1
		else
			high = mid - 1
		end
	end

	FontSize = best
end

local function sortedKeys(t)
	local keys = {}
	for k in t do
		if type(k) == "string" then table.insert(keys, k) end
	end
	table.sort(keys, function(a, b)
		local na = tonumber(a:match("^~(%d+)~"))
		local nb = tonumber(b:match("^~(%d+)~"))
		if na and nb then return na < nb end
		if na then return false end
		if nb then return true end
		return a < b
	end)
	return keys
end

local function cleanName(key: string): string
	return (key:gsub("^~%d+~", ""))
end

local function parseItem(key: string, value)
	local raw = value
	local extra = nil

	if type(value) == "table" then
		raw = value[1]
		extra = value[2]
	end

	if type(raw) ~= "string" then return nil end

	local kind, rest = raw:match("^!(%S)(.*)$")
	if not kind then return nil end

	local arg = nil
	local argStr = rest:match("^%b()")
	if argStr then
		arg = argStr:sub(2, -2)
		rest = rest:sub(#argStr + 1)
	end

	local initial = nil
	local initStr = rest:match("^%b[]")
	if initStr then
		initial = initStr:sub(2, -2)
		rest = rest:sub(#initStr + 1)
	end

	local text = rest:match("^%s*(.-)%s*$")

	return {
		Order = tonumber(key:match("^~(%d+)~")),
		Name = (key:gsub("^~%d+~", "")),
		Kind = kind,
		Arg = arg,
		Initial = initial,
		Text = text,
		Extra = extra,
	}
end

