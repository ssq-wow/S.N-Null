	local function frameLeftInSliderSpace(slider, frame)
		return frame.AbsolutePosition.X - slider.Parent.AbsolutePosition.X
	end

	local function getSliderPercent(slider, frame)
		local width = frame.AbsoluteSize.X
		if width <= 0 then
			return 0
		end

		local localX = slider.Position.X.Offset - frameLeftInSliderSpace(slider, frame)
		return math.clamp(localX / width, 0, 1)
	end

	local function setSliderPercent(slider, frame, percent)
		local xOffset = frameLeftInSliderSpace(slider, frame) + math.clamp(percent, 0, 1) * frame.AbsoluteSize.X
		slider.Position = UDim2.new(0, xOffset, slider.Position.Y.Scale, slider.Position.Y.Offset)
	end

	local function isPointerInput(input)
		local inputType = input.UserInputType
		return inputType == Enum.UserInputType.MouseButton1 or inputType == Enum.UserInputType.Touch
	end

	local function isPointerMovement(input)
		local inputType = input.UserInputType
		return inputType == Enum.UserInputType.MouseMovement or inputType == Enum.UserInputType.Touch
	end

	local function isInsideGui(gui, point)
		local min = gui.AbsolutePosition
		local max = min + gui.AbsoluteSize
		return point.X >= min.X and point.X <= max.X and point.Y >= min.Y and point.Y <= max.Y
	end

	local function setupSlider(slider, frame)
		local dragDetector = slider:FindFirstChildOfClass("UIDragDetector") or Instance.new("UIDragDetector")
		dragDetector.DragStyle = Enum.UIDragDetectorDragStyle.TranslateLine
		dragDetector.DragAxis = Vector2.new(1, 0)
		dragDetector.ResponseStyle = Enum.UIDragDetectorResponseStyle.Offset
		dragDetector.Parent = slider

		dragDetector:AddConstraintFunction(1, function(proposedPosition, proposedRotation)
			local left = frameLeftInSliderSpace(slider, frame)
			local xOffset = math.clamp(proposedPosition.X.Offset, left, left + frame.AbsoluteSize.X)
			return UDim2.new(0, xOffset, slider.Position.Y.Scale, slider.Position.Y.Offset), proposedRotation
		end)

		local function moveToScreenX(screenX)
			local width = frame.AbsoluteSize.X
			if width <= 0 then
				return
			end

			setSliderPercent(slider, frame, (screenX - frame.AbsolutePosition.X) / width)
		end

		frame.InputBegan:Connect(function(input)
			if not isPointerInput(input) then
				return
			end

			if isInsideGui(slider, input.Position) then
				return
			end

			moveToScreenX(input.Position.X)

			local moveConn, endConn

			moveConn = UserInputService.InputChanged:Connect(function(changed)
				if isPointerMovement(changed) then
					moveToScreenX(changed.Position.X)
				end
			end)

			endConn = UserInputService.InputEnded:Connect(function(ended)
				if ended.UserInputType == input.UserInputType then
					moveConn:Disconnect()
					endConn:Disconnect()
				end
			end)
		end)
	end

