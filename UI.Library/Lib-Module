					end
				end

				table.insert(ScaleFonts, TabButton)
			end
		end
	end

	local K = 2

	local function ApplyFont(v: TextLabel | TextButton, size: number)
		local scale = v:FindFirstChildOfClass("UIScale")
		local isFractional = size % 1 ~= 0

		if isFractional then
			if not v:GetAttribute("BaseSize") then
				v:SetAttribute("BaseSize", v.Size)
			end
			local base: UDim2 = v:GetAttribute("BaseSize")

			if not scale then
				scale = Instance.new("UIScale")
				scale.Parent = v
			end

			v.TextSize = math.clamp(math.round(size * K), 1, 100)
			scale.Scale = 1 / K
			v.Size = UDim2.new(
				base.X.Scale * K, base.X.Offset * K,
				base.Y.Scale * K, base.Y.Offset * K
			)
		else
			local base: UDim2? = v:GetAttribute("BaseSize")
			if base then
				v.Size = base
				v:SetAttribute("BaseSize", nil)
			end
			if scale then
				scale:Destroy()
			end

			v.TextSize = math.clamp(math.round(size), 1, 100)
		end
	end

	local function UpdateFonts()
		ScaleFont(MainGui.MainTitle, 2)

		for _, v in MainGui do
			if typeof(v) == "Instance" and (v:IsA("TextLabel") or v:IsA("TextButton")) then
				if not v.TextScaled then
					ApplyFont(v, FontSize + (v:GetAttribute("FontSize") or 0))
				end
			end
		end

		for _, v: TextLabel | TextButton in ScaleFonts do
			ApplyFont(v, FontSize + (v:GetAttribute("FontSize") or 0))
		end
	end

	MainGui.ScreenGui:GetPropertyChangedSignal("AbsoluteSize"):Connect(UpdateFonts)
	MainGui.Holder:GetPropertyChangedSignal("AbsoluteSize"):Connect(UpdateFonts)
	UpdateFonts()

	MainGui.Holder.Visible = false

	bind(UI_Toggle, function()
		MainGui.Holder.Visible = not MainGui.Holder.Visible
	end)
	
	MainGui.ScreenGui.Parent = Unwrap_(CoreGui)
	
	for index, v in UI_Data do
		UI_Data[index] = track(v, index)
	end
	
	local function SearchVars(varname)
		local Fetched = {}

		for index, v in Data do
			local order: number = tonumber(index:match("^~(%d+)~"))
			local content: string = index:match("^~%d+~(.*)")

			if order and content then
				if UI_Data[content][varname] then
					Fetched[order] = UI_Data[content][varname]
				end
			end
		end

		return Fetched
	end
	
	ClientEnv.Get = function(varname)
		local Fetched = {}

		for index, v in Data do
			local order: number = tonumber(index:match("^~(%d+)~"))
			local content: string = index:match("^~%d+~(.*)")

			if order and content then
				if UI_Data[content][varname] then
					Fetched[order] = UI_Data[content][varname]
				end
			end
		end

		return Fetched
	end
	
	ClientEnv.BindKey = function(varname, taborder, maincall)
		local Pointer = ""
		
		for index, v in Data do
			local order: number = tonumber(index:match("^~(%d+)~"))
			local content: string = index:match("^~%d+~(.*)")

			if order == taborder then
				Pointer = content
			end
		end
		
		
		if not UI_Data[Pointer][varname] then
			warn(varname, "does not exist in", Pointer)
			return nil
		end
		
		local ev1, ev2
		
		ev1 = UserInputService.InputBegan:Connect(function(input, gameProcessed)
			local key = input.KeyCode
			if validKeys[key] and UI_Data[Pointer][varname] == key then
				pcall(maincall, "Began", gameProcessed)
			end
		end)
		
		ev2 = UserInputService.InputEnded:Connect(function(input, gameProcessed)
			local key = input.KeyCode
			if validKeys[key] and UI_Data[Pointer][varname] == key then
				pcall(maincall, "Ended", gameProcessed)
			end
		end)
		
		local Disc = {}
		
		function Disc:Disconnect()
			pcall(function()
				ev1:Disconnect()
				ev2:Disconnect()
			end)
			Disc = nil
		end
		
		return Disc
	end
	
	ClientEnv.Wrap = Wrap_
	ClientEnv.Unwrap = Unwrap_
	
	return UI_Data
end

return module
