local function compact(t)
	local keys = {}
	for k in pairs(t) do
		keys[#keys + 1] = k
	end
	table.sort(keys)

	local result = {}
	for i, k in ipairs(keys) do
		result[i] = t[k]
	end
	return result
end

local function formatValue(v, indent, seen)
	local t = type(v)

	if t == "string" then
		return '"' .. v .. '"'
	elseif t ~= "table" then
		return tostring(v)
	end

	v = Registry_.get(v) or v

	if seen[v] then
		return "{...}"
	end
	seen[v] = true

	local keys = {}
	for k in v do
		table.insert(keys, k)
	end
	table.sort(keys, function(a, b)
		local ta, tb = type(a), type(b)
		if ta == "number" and tb == "number" then return a < b end
		if ta == "number" then return true end
		if tb == "number" then return false end
		return tostring(a) < tostring(b)
	end)

	if #keys == 0 then
		seen[v] = nil
		return "{}"
	end

	local pad = string.rep("\t", indent + 1)
	local lines = {}
	for _, k in keys do
		local keyStr = type(k) == "string" and ('["' .. k .. '"]') or ("[" .. tostring(k) .. "]")
		table.insert(lines, pad .. keyStr .. " = " .. formatValue(v[k], indent + 1, seen))
	end

	seen[v] = nil
	return "{\n" .. table.concat(lines, ",\n") .. "\n" .. string.rep("\t", indent) .. "}"
end

local function makeProxy(original, onWrite, extras, onChanged)
	extras = extras or {}
	setmetatable(extras, { __index = original })

	local proxy = {}

	setmetatable(proxy, {
		__index = extras,

		__newindex = function(_, key, value)
			local old = original[key]
			if onWrite and onWrite(key, value, old) == false then
				return
			end
			rawset(original, key, value)
			if onChanged and not rawequal(value, old) then
				onChanged(key, value, old)
			end
		end,

		__len = function() return #original end,
		__iter = function() return next, original end,

		__tostring = function()
			return formatValue(original, 0, {})
		end,

		__metatable = "locked",
	})

	Registry_.register(proxy, original)
	return proxy, extras
end

