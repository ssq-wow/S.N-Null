	local function track(raw, name)
		local nextId = 0
		local Changed = {}

		function Changed:Connect(func)
			nextId += 1
			local id = nextId
			Listeners[name][id] = func

			local Connection = {}
			function Connection:Disconnect()
				Listeners[name][id] = nil
			end
			return Connection
		end

		return setmetatable({}, {
			__index = function(_, key)
				if key == "Changed" then return Changed end
				return raw[key]
			end,

			__newindex = function(_, key, value)
				local old = raw[key]
				raw[key] = value

				local setter = Setters[name][key]
				if setter then setter(value) end

				if not rawequal(old, value) then
					Fire(name, key, value, old)
				end
			end,

			__len = function() return #raw end,
			__iter = function() return next, raw end,
			__tostring = function() return formatValue(raw, 0, {}) end,
			__metatable = "locked",
		})
	end
	


