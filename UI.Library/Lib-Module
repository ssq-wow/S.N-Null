	local colourSamples = {}
	for i = 0, SEARCH_STEPS do
		colourSamples[i] = { getColourRGB(i / SEARCH_STEPS) }
	end

	local function findClosestMatch(r, g, b)
		local bestDistance = math.huge
		local best = { 0, 0, 0, 0, 0 }

		for ci = 0, SEARCH_STEPS do
			local sample = colourSamples[ci]

			for di = 0, SEARCH_STEPS do
				local rr, rg, rb = applyLightness(sample[1], sample[2], sample[3], di / SEARCH_STEPS)
				local distance = (rr - r) ^ 2 + (rg - g) ^ 2 + (rb - b) ^ 2

				if distance < bestDistance then
					bestDistance = distance
					best = { ci, di, rr, rg, rb }

					if distance == 0 then
						return table.unpack(best)
					end
				end
			end
		end

		return table.unpack(best)
	end

	local function setColourRGB(r, g, b)
		r = math.clamp(math.floor(r), 0, 255)
		g = math.clamp(math.floor(g), 0, 255)
		b = math.clamp(math.floor(b), 0, 255)

		local colourIndex, darknessIndex, bestR, bestG, bestB = findClosestMatch(r, g, b)

		setSliderPercent(ColorSlider, ColorBar, colourIndex / SEARCH_STEPS)
		setSliderPercent(DarknessSlider, DarknessBar, darknessIndex / SEARCH_STEPS)

		updateColourPreview()

		return bestR, bestG, bestB
	end

	local function setColour3(colour)
		return setColourRGB(colour.R * 255, colour.G * 255, colour.B * 255)
	end


